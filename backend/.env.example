# ---- SQL Server -------------------------------------------------------------
MSSQL_HOST=your-server.rds.amazonaws.com
# Leave empty for a named instance (MSSQL_HOST=localhost\SQLEXPRESS)
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
# yes = use the current Windows login instead of USER / PASSWORD
MSSQL_TRUSTED=no
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=yes
MSSQL_TRUST_CERT=yes
# A table another session is writing to (an open transaction) keeps its row count metadata
# locked though its rows stay readable; it is then counted directly, read uncommitted, and
# shown as "loading". Seconds one such count may take, and all of them per database read;
# 0 = never count directly (such tables are then shown as locked).
MSSQL_BUSY_COUNT_TIMEOUT=60
MSSQL_BUSY_COUNT_BUDGET=120

# ---- Databases ------------------------------------------------------------
DB_SOURCE_A_NAME=AppMasterDB_UAT
DB_SOURCE_A_LABEL=A

DB_SOURCE_B_NAME=AppMasterEngDB_Local
DB_SOURCE_B_LABEL=B

DB_TARGET_NAME=AlTasnimBI
DB_TARGET_LABEL=T

# ---- AI summary -------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# OPENAI_BASE_URL=

# ---- ATNM -> RDS copy check (app/ATNM) --------------------------------------
# The client's ATNM server, reached over the VPN. Its databases are compared with their
# copies on the server above (MSSQL_HOST). Use a read-only login.
ATNM_LABEL=ATNM
ATNM_TARGET_LABEL=RDS
ATNM_MSSQL_HOST=atnm-server-host-or-ip
# Leave empty for a named instance (ATNM_MSSQL_HOST=host\INSTANCE)
ATNM_MSSQL_PORT=1433
ATNM_MSSQL_USER=
ATNM_MSSQL_PASSWORD=
# yes = use the current Windows login instead of USER / PASSWORD
ATNM_MSSQL_TRUSTED=no
# Defaults to MSSQL_DRIVER when empty
ATNM_MSSQL_DRIVER=ODBC Driver 18 for SQL Server
ATNM_MSSQL_ENCRYPT=yes
ATNM_MSSQL_TRUST_CERT=yes
# Seconds to wait for a login (a VPN that is down fails after this)
ATNM_LOGIN_TIMEOUT=15

# Database pairs: <n>_SOURCE on the ATNM server, <n>_TARGET its copy on RDS.
# Add ATNM_DB_3_SOURCE / ATNM_DB_3_TARGET ... for more; numbering must not skip.
ATNM_DB_1_SOURCE=AppMasterDB
ATNM_DB_1_TARGET=AppMasterDB_UAT
ATNM_DB_2_SOURCE=AppMasterEngDB
ATNM_DB_2_TARGET=AppMasterEngDB_Local

# Seconds one data query may run (one pass over a 73M row table takes ~40 min);
# lock wait before a table is reported locked.
ATNM_QUERY_TIMEOUT=7200
ATNM_LOCK_TIMEOUT_MS=5000
# Most rows per side read (keys and hashes only) to find which rows differ.
ATNM_DIFF_ROWS_MAX=100000
# Tables above this many rows are not value-checked; 0 = no limit.
ATNM_DATA_CHECK_MAX_ROWS=0
# Where the results are kept (default backend/.cache/atnm_checks.json)
# ATNM_RESULT_FILE=
# A lost connection (VPN down) is tried again after these waits (seconds); then the run
# pauses and tries every ATNM_PAUSE_POLL seconds, going on by itself once the server answers.
ATNM_RETRY_WAITS=30,60,120
ATNM_PAUSE_POLL=30
# The run in progress, so it can be resumed after a restart (default backend/.cache/atnm_run.json)
# ATNM_RUN_FILE=
# Every step of every check (default backend/.cache/atnm.log; also printed in the backend console)
# ATNM_LOG_FILE=
# Optional per-table settings such as a cutoff for live tables (default backend/mappings/atnm.yaml)
# ATNM_OPTIONS_FILE=

# ---- Renamed columns, decided by the data (app/renames.py) ---------------------
# A rename is confirmed only when a source column and a target column are identical on
# 100% of the paired rows. These settle how much evidence that needs and how it runs.
# Filled values a verified pair needs (smaller tables: half their paired rows)
RENAME_MIN_VALUES=100
# Share of the smaller table's rows that must pair up for a rename to be verified
RENAME_MIN_COVERAGE=0.5
# Near misses below this share of identical rows are not listed at all
RENAME_POSSIBLE_MIN=0.5
# Tables above this many rows try every pair on a sample first (it only rules pairs out)
RENAME_FULL_BELOW=200000
RENAME_SAMPLE_ROWS=10000
# Pairs measured in one query; seconds one query may run
RENAME_BATCH=25
RENAME_TIMEOUT=7200
# RENAME_FILE=      (default backend/.cache/rename_checks.json)
# RENAME_LOG_FILE=  (default backend/.cache/renames.log)
