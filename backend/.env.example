# ---- SQL Server -------------------------------------------------------------
MSSQL_HOST=your-server.rds.amazonaws.com
# Leave empty for a named instance (MSSQL_HOST=localhost\SQLEXPRESS)
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
# yes = use the current Windows login instead of USER / PASSWORD
MSSQL_TRUSTED=no
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=yes
MSSQL_TRUST_CERT=yes

# ---- Databases ------------------------------------------------------------
DB_SOURCE_A_NAME=AppMasterDB_UAT
DB_SOURCE_A_LABEL=A

DB_SOURCE_B_NAME=AppMasterEngDB_Local
DB_SOURCE_B_LABEL=B

DB_TARGET_NAME=AlTasnimBI
DB_TARGET_LABEL=T

# ---- AI summary -------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# OPENAI_BASE_URL=

# ---- ATNM -> RDS copy check (app/ATNM) --------------------------------------
# The client's ATNM server, reached over the VPN. Its databases are compared with their
# copies on the server above (MSSQL_HOST). Use a read-only login.
ATNM_LABEL=ATNM
ATNM_TARGET_LABEL=RDS
ATNM_MSSQL_HOST=atnm-server-host-or-ip
# Leave empty for a named instance (ATNM_MSSQL_HOST=host\INSTANCE)
ATNM_MSSQL_PORT=1433
ATNM_MSSQL_USER=
ATNM_MSSQL_PASSWORD=
# yes = use the current Windows login instead of USER / PASSWORD
ATNM_MSSQL_TRUSTED=no
# Defaults to MSSQL_DRIVER when empty
ATNM_MSSQL_DRIVER=ODBC Driver 18 for SQL Server
ATNM_MSSQL_ENCRYPT=yes
ATNM_MSSQL_TRUST_CERT=yes
# Seconds to wait for a login (a VPN that is down fails after this)
ATNM_LOGIN_TIMEOUT=15

# Database pairs: <n>_SOURCE on the ATNM server, <n>_TARGET its copy on RDS.
# Add ATNM_DB_3_SOURCE / ATNM_DB_3_TARGET ... for more; numbering must not skip.
ATNM_DB_1_SOURCE=AppMasterDB
ATNM_DB_1_TARGET=AppMasterDB_UAT
ATNM_DB_2_SOURCE=AppMasterEngDB
ATNM_DB_2_TARGET=AppMasterEngDB_Local

# Seconds one data query may run (one pass over a 73M row table takes ~40 min);
# lock wait before a table is reported locked.
ATNM_QUERY_TIMEOUT=7200
ATNM_LOCK_TIMEOUT_MS=5000
# Most rows per side read (keys and hashes only) to find which rows differ.
ATNM_DIFF_ROWS_MAX=100000
# Tables above this many rows are not value-checked; 0 = no limit.
ATNM_DATA_CHECK_MAX_ROWS=0
# Where the results are kept (default backend/.cache/atnm_checks.json)
# ATNM_RESULT_FILE=
