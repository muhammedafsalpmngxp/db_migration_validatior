# ---- Microsoft SQL Server -------------------------------------------------
MSSQL_HOST=localhost
# Leave MSSQL_PORT empty when you connect to a named instance (MSSQL_HOST=host\SQLEXPRESS)
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=Your_password123
# Use the Windows login of the current user instead of MSSQL_USER / MSSQL_PASSWORD
MSSQL_TRUSTED=no
# Must match an installed driver: run `uv run check_setup.py` to see what you have
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
# Driver 18 encrypts by default; keep TRUST_CERT=yes for a local dev certificate
MSSQL_ENCRYPT=yes
MSSQL_TRUST_CERT=yes
# Empty = compare every user schema; set one name or a comma separated list to narrow
MSSQL_SCHEMA=

# The two databases to compare (A = baseline, B = candidate)
DB_A_NAME=AppMasterDB_UAT
DB_B_NAME=AlTasnimBI
DB_A_LABEL=A (AppMasterDB_UAT)
DB_B_LABEL=B (AlTasnimBI)

# ---- LLM ------------------------------------------------------------------
# openai | anthropic | mock      ("mock" runs the agent offline, no key needed)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-...
# Any chat model your key can reach: gpt-4o, gpt-4o-mini, gpt-4.1, gpt-5, o4-mini, ...
LLM_MODEL=gpt-4o
# Optional: Azure / gateway / local compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1

# Only used when LLM_PROVIDER=anthropic (uv sync --extra anthropic)
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Agent limits ---------------------------------------------------------
MAX_AGENT_STEPS=8
MAX_SUPERVISOR_RETRIES=1
ROW_COMPARE_LIMIT=5000

# ---- Observability --------------------------------------------------------
LOG_LEVEL=INFO
# Characters of each prompt/response kept for the UI pipeline pane (0 disables)
LLM_TRACE_CHARS=20000

# ---- Deployment (docker compose) ------------------------------------------
# Where the container publishes. 127.0.0.1 keeps it private to the host, for a run
# behind nginx or an ALB; 0.0.0.0 exposes it to whatever the security group allows.
BIND_ADDRESS=0.0.0.0
HOST_PORT=8501
# CORS is off by default, which in Streamlit means every origin is allowed. Only safe
# while port 8501 is closed to the internet - see docs/DEPLOY_EC2.md. To lock it down:
#   STREAMLIT_ENABLE_CORS=true
#   CORS_ORIGINS=https://dbcompare.internal.example.com
STREAMLIT_ENABLE_CORS=false
CORS_ORIGINS=
