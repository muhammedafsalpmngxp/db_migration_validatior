  <diagram id="page-workflow" name="2. Application workflow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="w-title" value="Application workflow — one comparison, start to finish" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="800" height="40" as="geometry" />
        </mxCell>

        <mxCell id="w-l1" value="Configure" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F6F9;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#5A6570;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="180" height="30" as="geometry" />
        </mxCell>

        <mxCell id="w1" value="load_dotenv() at the top of app.py&#10;(.env before the widgets, or the sidebar&#10;defaults would overwrite it)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A7EBB;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="240" y="90" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="Sidebar: server · port · auth (SQL login or&#10;Windows) · ODBC driver · trust cert ·&#10;database A / B · LLM provider, model, key ·&#10;step budget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A7EBB;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="90" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="os.environ.update(...) then&#10;importlib.reload(config)&#10;— config is read at import time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A7EBB;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="90" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="w-l2" value="Pick the scope" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F6F9;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#5A6570;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="180" height="30" as="geometry" />
        </mxCell>

        <mxCell id="w4" value="ping both databases&#10;→ connection cards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A7EBB;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="210" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w5" value="list_tables() per side&#10;@st.cache_data(ttl=300)&#10;qualified: schema.table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A7EBB;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="210" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w6" value="two multiselects, mirrored on the bare&#10;table name — a pick on either side&#10;resolves to that side's own schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A7EBB;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="720" y="205" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="w7" value="question + Run comparison" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F7;strokeColor=#4A7EBB;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1060" y="210" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="w-l3" value="Run" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F6F9;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#5A6570;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="180" height="30" as="geometry" />
        </mxCell>

        <mxCell id="w8" value="run_comparison(question, on_progress, tables)&#10;&#10;setup_logging() · LLM_STATS.reset() · log buffer cleared&#10;shared = {question, tables, history, trace, errors}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F1E6;strokeColor=#4F8A5B;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="240" y="320" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="w9" value="PocketFlow graph runs&#10;(see tab 3 — Agents &amp; nodes)&#10;progress lines stream to st.status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F1E6;strokeColor=#4F8A5B;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="320" width="300" height="90" as="geometry" />
        </mxCell>
