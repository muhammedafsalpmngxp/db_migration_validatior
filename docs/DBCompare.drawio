        <mxCell id="w-l4" value="Read the result" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F6F9;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#5A6570;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="180" height="30" as="geometry" />
        </mxCell>

        <mxCell id="w-metrics" value="Metric rows — tables only in A / only in B / schema changes / data drift    ·    LLM calls · tokens consumed (in / out) · run time · errors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B6C2CF;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="240" y="460" width="1040" height="40" as="geometry" />
