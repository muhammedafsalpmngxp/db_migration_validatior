        <mxCell id="we2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=blockThin;endFill=1;strokeColor=#5A6570;" edge="1" parent="1" source="w2" target="w3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="we3" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=blockThin;endFill=1;strokeColor=#5A6570;" edge="1" parent="1" source="w3" target="w4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1180" y="190" />
              <mxPoint x="340" y="190" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="we4" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=blockThin;endFill=1;strokeColor=#5A6570;" edge="1" parent="1" source="w4" target="w5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="we5" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=blockThin;endFill=1;strokeColor=#5A6570;" edge="1" parent="1" source="w5" target="w6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="we6" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=blockThin;endFill=1;strokeColor=#5A6570;" edge="1" parent="1" source="w6" target="w7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="we7" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=blockThin;endFill=1;strokeColor=#5A6570;" edge="1" parent="1" source="w7" target="w8">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1170" y="295" />
              <mxPoint x="430" y="295" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="we8" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=blockThin;endFill=1;strokeColor=#5A6570;" edge="1" parent="1" source="w8" target="w9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="we9" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=blockThin;endFill=1;strokeColor=#5A6570;" edge="1" parent="1" source="w9" target="w10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="we10" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=blockThin;endFill=1;strokeColor=#5A6570;" edge="1" parent="1" source="w10" target="w-metrics">
          <mxGeometry relative="1" as="geometry" />
