        <mxCell id="w-note" value="Scope drives cost: selecting tables pushes the filter into introspection&#10;(fetch_schema(only=...)), so row counts run only for those tables.&#10;Measured: 3 tables 6.0s · all tables 52s (mock) / 135s (with matching).&#10;&#10;Leaving both pickers empty is the AI path: the agent proposes the matches&#10;(tab 3 of this file), and its proposals are validated against both table lists." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFF4E5;strokeColor=#C08A34;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="640" width="480" height="140" as="geometry" />
        </mxCell>

        <mxCell id="we1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=blockThin;endFill=1;strokeColor=#5A6570;" edge="1" parent="1" source="w1" target="w2">
          <mxGeometry relative="1" as="geometry" />
